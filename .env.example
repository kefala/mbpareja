# Conexión Mongo Atlas (sólo servidor). Nunca NEXT_PUBLIC_* — la cadena no debe llegar al bundle.
# Mismo cluster que final/online; base distinta.
ATLAS_URI=your_atlas_connection_string
ATLAS_DB_NAME=mbpareja
# Alias opcional (compat final/online):
# ATLAS_MIRROR_DB_NAME=mbpareja

# Emails permitidos (Google OAuth), exactamente 2, separados por coma:
# ALLOWED_EMAILS=persona1@dominio.com,persona2@dominio.com
# Alias compatible al copiar de final:
# ONLINE_ALLOWED_EMAILS=persona1@dominio.com,persona2@dominio.com

# NextAuth (mismo Google Client ID que final; añadir redirect del nuevo origen):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=  # openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3003
# Producción (subdominio a configurar): NEXTAUTH_URL=https://mbpareja.x.com
